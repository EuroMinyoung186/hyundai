<?xml version="1.0" encoding="utf-8"?>
<!--
  휴대폰 연결용 중계 서버(PC 의 tools/sim/phone-relay.py, adb reverse 로 127.0.0.1:8090)는 HTTP 라서
  이 주소들로 가는 평문 통신만 허용한다. 그 밖의 주소는 기본값(HTTPS 만)을 그대로 따른다.
  (11/15: release 빌드에서 평문 통신이 막혀 휴대폰 연결이 안 되던 문제. debug 는 src/debug 매니페스트가 전체 허용)
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
